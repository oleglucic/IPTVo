# ── Database (required) ──────────────────────────────────────────
# DATABASE_URL - PostgreSQL connection string (e.g. postgresql://user:password@host:5432/dbname)
#   Used for users, ai_overrides, epg_history, logo_urls tables.
#   If missing, schema init is skipped and DB-backed features are unavailable.

DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis (required) ─────────────────────────────────────────────
# REDIS_URL - Redis connection string (e.g. rediss://user:password@host:6379/0)
#   Used for channel cache persistence, session management, EPG hub generation.
#   If missing, app runs in memory-only mode with cache persistence disabled.

REDIS_URL=rediss://user:password@host:6379/0

# ── Security (required) ──────────────────────────────────────────
# ENCRYPTION_KEY - 32-byte master key for AES-256-GCM user config encryption.
#   Required. Without it, user configs cannot be encrypted or decrypted.
#   Generate with: openssl rand -hex 32

ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ── Server (optional — safe defaults if unset) ──────────────────
# PORT - Server HTTP port.
#   Default: 3000

PORT=3000

# ASSET_BASE_URL - Cloudflare assets base URL (e.g. https://assets.oleglucic.com).
#   When set, poster/logo/catalog links resolve to the edge Worker instead of
#   the request host, offloading the Node server. Falls back to request host.
#   Default: '' (no offloading)

ASSET_BASE_URL=

# POSTER_HOST_ALLOWLIST - Comma-separated hostname allowlist for poster routes.
#   If configured, poster URLs are only served from allowlisted hosts, preventing
#   host header injection when behind a reverse proxy.
#   Default: '' (accept any host)

POSTER_HOST_ALLOWLIST=

# CLUSTER_WORKERS - Node cluster worker process count.
#   0 or 1 = single-process (cluster disabled).
#   auto = half CPU cores (capped, conservative).
#   N > 1 = fork N workers.
#   Default: 0 (single process, recommended for free tier)

CLUSTER_WORKERS=0

# LOG_LEVEL - Log level for the central logger.
#   debug|info|warn|error. Honored via LOG_LEVEL env var.
#   Default: info

LOG_LEVEL=info

# LOG_FORMAT - Log output format.
#   '' = human-readable text, 'json' = structured JSON lines.
#   Default: '' (human-readable)

LOG_FORMAT=

# TURNSTILE_SECRET - Cloudflare Turnstile secret for bot protection on auth endpoints.
#   Optional. If not set, Turnstile verification is skipped.
#   Required for /api/auth/register and /api/auth/login if Turnstile is enabled.

TURNSTILE_SECRET=

# TURNSTILE_HOSTNAMES - Comma-separated list of allowed Turnstile hostnames.
#   Default: '' (accept any hostname).

TURNSTILE_HOSTNAMES=

# ── EPG & Matching sources (optional) ────────────────────────────
# OPENROUTER_API_KEY - OpenRouter API key for AI-powered channel curation.
#   Used for auth check in /health/detailed endpoint.
#   Deprecated: per-user config is now used instead; this is server-level only.
#   If unset, OpenRouter status in health check will show as not_configured.

OPENROUTER_API_KEY=

# EPG_HUB_CONCURRENCY - EPG hub fetch concurrency cap.
#   math: max(1, min(16, parsed integer)).
#   Default: computed from code (clamped 1-16).

EPG_HUB_CONCURRENCY=3

# PREWARM_CONCURRENCY - Logo prewarm batch concurrency.
#   Number of parallel workers rendering posters/logos.
#   Default: 8

PREWARM_CONCURRENCY=8

# LOGO_PROXY_URL - Cloudflare Worker logo proxy URL.
#   Fetches channel logos through the Worker edge network.
#   Default: derived from ASSET_BASE_URL or
#   'https://logo-proxy.your-worker.workers.dev/logo'

LOGO_PROXY_URL=https://logo-proxy.your-worker.workers.dev/logo

# IPTVO_ALLOW_INLINE_M3U - Enable inline M3U content parsing.
#   Set to '1' to allow M3U entries without external URLs.
#   Default: not set (inline M3U disabled).

IPTVO_ALLOW_INLINE_M3U=

# ── Everything else found in the code ────────────────────────────
# MAX_CONCURRENT_PARSES - Max concurrent M3U/Xtream parses.
#   Controls how many playlist entries are parsed simultaneously.
#   Default: 4

MAX_CONCURRENT_PARSES=4

# DAILY_REFRESH_CONCURRENCY - Max concurrent parses during daily refresh.
#   Controls how many M3U/Xtream entries are parsed simultaneously.
#   Default: 5

DAILY_REFRESH_CONCURRENCY=5

# ADDON_CACHE_URL - Edge-addon cache purge target URL.
#   bumps the addon-cache Worker's KV generation after config changes.
#   Default: '' (no edge cache worker configured)

ADDON_CACHE_URL=

# EDGE_PURGE_SECRET - Secret shared with the Edge Workers for /api/_edge-purge.
#   Requests must include x-purge-secret header matching this value.
#   Default: not set (purge endpoint returns 403).

EDGE_PURGE_SECRET=