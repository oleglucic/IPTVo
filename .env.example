# IPTVo Environment Configuration
# Copy to .env and fill in your values

# REQUIRED: 32+ character secret for AES-GCM config encryption
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# REQUIRED for local Docker Compose (Option A / Option 3 in README)
# PostgreSQL password for the 'iptvo' user
POSTGRES_PASSWORD=

# REQUIRED: Cloudflare Worker logo proxy URL
# Format: https://your-worker.your-account.workers.dev/logo
# Or your custom domain: https://assets.yourdomain.com/logo
LOGO_PROXY_URL=

# =========================================================================
# OPTIONAL: Override auto-constructed URLs (only needed for external DB/Redis)
# =========================================================================

# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# REDIS_URL=redis://default:pass@host:6379
# REDIS_URL=rediss://default:pass@host:6379  # TLS (Upstash, etc.)

# =========================================================================
# DEPRECATED: Server-level OpenRouter key (use per-user config in dashboard instead)
# =========================================================================
# OPENROUTER_API_KEY=

# =========================================================================
# OPTIONAL: Server port (default 3000)
# =========================================================================
# PORT=3000

# =========================================================================
# OPTIONAL: Horizontal scaling & perf tuning
# =========================================================================
# 0=single process, 'auto'=half your cores, or an explicit worker count
# CLUSTER_WORKERS=0
# Concurrency for the central EPG hub fetcher (default 3, max 16)
# EPG_HUB_CONCURRENCY=3
# Max concurrent provider (m3u/xtream) parses (default 4)
# MAX_CONCURRENT_PARSES=4
# Concurrent cache pre-warm fetches (default 8)
# PREWARM_CONCURRENCY=8

# =========================================================================
# OPTIONAL: Cloudflare assets/edge integration
# =========================================================================
# Base URL for posters/logos/catalog links when served via the CF assets Worker
# ASSET_BASE_URL=https://assets.oleglucic.com
# Addon-cache Worker URL for edge-cache purging (e.g. https://addon-cache.worker.dev)
# ADDON_CACHE_URL=
# Shared secret guarding the /api/_edge-purge endpoint
# EDGE_PURGE_SECRET=

# =========================================================================
# OPTIONAL: Cloudflare Turnstile bot protection for login/register
# =========================================================================
# Secret from the Turnstile widget (https://dash.cloudflare.com -> Turnstile)
# Only needed if you want bots blocked from sign-in/register. Unset disables.
TURNSTILE_SECRET=
# Comma-separated hostnames the token's source host must match (your deploy host).
# IMPORTANT: do NOT include localhost/127.0.0.1 here when this is the prod backend.
TURNSTILE_HOSTNAMES=iptvo.oleglucic.com

# =========================================================================
# OPTIONAL: Poster host header validation (security hardening)
# =========================================================================
# Comma-separated allowlist of hostnames for poster URL generation (e.g. iptvo.oleglucic.com)
# When set, validates req.get('host') against this list to prevent host header injection.
# Unset = accept any host (local/dev friendly). Recommended for production deployments.
# POSTER_HOST_ALLOWLIST=iptvo.oleglucic.com