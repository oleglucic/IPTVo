# ── Database (required) ──────────────────────────────────────────
# DATABASE_URL - PostgreSQL connection string (e.g. postgresql://user:password@host:5432/dbname)

DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis (required) ─────────────────────────────────────────────
REDIS_URL=rediss://user:password@host:6379/0

# ── Security (required) ──────────────────────────────────────────
# ENCRYPTION_KEY - 32-byte master key for AES-256-GCM. Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ── Server (optional) ────────────────────────────────────────────
PORT=3000
ASSET_BASE_URL=
POSTER_HOST_ALLOWLIST=
CLUSTER_WORKERS=0
LOG_LEVEL=info
LOG_FORMAT=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

# ── EPG & matching (optional) ────────────────────────────────────
OPENROUTER_API_KEY=
EPG_HUB_CONCURRENCY=3
PREWARM_CONCURRENCY=8
LOGO_PROXY_URL=https://logo-proxy.your-worker.workers.dev/logo
IPTVO_ALLOW_INLINE_M3U=

# ── Concurrency limiting (optional, opt-in) ──────────────────────
# CONCURRENCY_LIMIT_ENABLED - HLS relay + per-user stream limits. Default: false
CONCURRENCY_LIMIT_ENABLED=false
CONCURRENCY_EVICTION_COUNTDOWN_MS=15000
CONCURRENCY_SESSION_IDLE_TIMEOUT_MS=45000

# MAX_CONCURRENT_PARSES - concurrent M3U/Xtream parses. Default: 4
MAX_CONCURRENT_PARSES=4

DAILY_REFRESH_CONCURRENCY=5
ADDON_CACHE_URL=
EDGE_PURGE_SECRET=

# ── Transcoding (optional, opt-in, independent of concurrency) ───
# TRANSCODE_ENABLED - ABR ladder + encode jobs. Default: false
# TRANSCODE_RENDITIONS - heights, e.g. 1080,720,480,360
# TRANSCODE_CODEC - h264 | hevc | av1
# TRANSCODE_HWACCEL - none | nvenc | qsv | vaapi
# TRANSCODE_VAAPI_DEVICE - VAAPI render node (Linux). Default: /dev/dri/renderD128
# TRANSCODE_CRF - quality (software / quality scale)
# TRANSCODE_PRESET - software preset; mapped for nvenc / SVT-AV1
# TRANSCODE_MAX_CONCURRENT_JOBS - global encode cap (Redis-backed when Redis is up)

TRANSCODE_ENABLED=false
TRANSCODE_RENDITIONS=1080,720,480,360
TRANSCODE_CODEC=h264
TRANSCODE_HWACCEL=none
TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD128
TRANSCODE_CRF=23
TRANSCODE_PRESET=veryfast
TRANSCODE_MAX_CONCURRENT_JOBS=2
