{
  "name": "iptvo",
  "version": "0.0.1",
  "description": "IPTVo - Stremio/Nuvio IPTV addon with intelligent channel deduplication, iptv-org integration, AI curation, and automatic poster generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "release": "standard-version && git push --follow-tags origin main",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "changelog": "standard-version --release-as minor --dry-run"
  },
  "keywords": [
    "stremio",
    "nuvio",
    "iptv",
    "addon",
    "tv",
    "live",
    "cloudflare",
    "redis",
    "postgresql",
    "ai-curation"
  ],
  "author": "Oleg Lučić",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "fuse.js": "^7.5.0",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "sax": "^1.4.1",
    "sharp": "^0.35.3",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "standard-version": "^9.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  }
}