{
  "name": "iptvo",
  "version": "0.0.1",
  "description": "IPTVo - Stremio/Nuvio IPTV addon with intelligent channel deduplication, iptv-org integration, AI curation, and automatic poster generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "lint": "eslint .",
    "type-check": "node --check server.js",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "stremio",
    "nuvio",
    "iptv",
    "addon",
    "tv",
    "live",
    "cloudflare",
    "redis",
    "postgresql",
    "ai-curation"
  ],
  "author": "Oleg Lučić",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fuse.js": "^7.5.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "sax": "^1.4.1",
    "sharp": "^0.35.3",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^12.0.9",
    "commitlint": "^19.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-html": "^8.0.0",
    "globals": "^17.11.0",
    "husky": "^9.0.0",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  },
  "overrides": {
    "router": "^2.0.0",
    "path-to-regexp": "^6.2.0",
    "tmp": "^0.2.6",
    "inquirer": "^9.3.7"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": []
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
