{
  "name": "iptvo",
  "version": "2.0.0",
  "description": "IPTVo - Stremio/Nuvio IPTV addon with intelligent channel deduplication, iptv-org integration, AI curation, and automatic poster generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "lint": "eslint .",
    "type-check": "node --check server.js",
    "test": "jest",
    "integrity": "node scripts/integrity-manifest.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).[tj]s?(x)"
    ],
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/__tests__/**",
      "!**/*.config.js",
      "!server.js"
    ]
  },
  "keywords": [
    "stremio",
    "nuvio",
    "iptv",
    "addon",
    "tv",
    "live",
    "cloudflare",
    "redis",
    "postgresql",
    "ai-curation"
  ],
  "author": "Oleg Lučić",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oleglucic/IPTVo.git"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fuse.js": "^7.5.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "sax": "^1.4.1",
    "sharp": "^0.35.3",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "13.1.5",
    "commitlint": "^19.0.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-html": "^8.0.0",
    "globals": "^17.11.0",
    "husky": "^9.0.0",
    "jest": "^30.4.2",
    "npm": "^11.19.1",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  },
  "overrides": {
    "router": "^2.0.0",
    "path-to-regexp": "^6.2.0",
    "tmp": "^0.2.6",
    "inquirer": "^9.3.7",
    "qs": "^6.16.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      [
        "./release-plugin.js",
        {
          "generator": [
            "@semantic-release/release-notes-generator",
            {
              "preset": "conventionalcommits",
              "writerOpts": {
                "groupBy": "type",
                "commitGroupsSort": [
                  "feat",
                  "fix",
                  "perf",
                  "refactor",
                  "docs",
                  "style",
                  "test",
                  "chore"
                ],
                "commitsSort": "scope"
              }
            }
          ]
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": []
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
